# ---------------------------------------------------------------------------
# Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est ignore par git : aucun secret ne doit etre commite.
# ---------------------------------------------------------------------------

# --- OpenSky Network -------------------------------------------------------
# Optionnel : sans ces valeurs le pipeline tourne en mode ANONYME
# (400 credits/jour, pas de donnees historiques, resolution 10s).
# Pour obtenir un couple client_id / client_secret :
#   1. creer un compte sur https://opensky-network.org
#   2. page "Account" -> "API Client" -> creer un client
# Depuis mars 2025 OpenSky n'accepte plus que le flow OAuth2
# client_credentials (le basic auth login/mot de passe est supprime).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Perimetre geographique -----------------------------------------------
# Valeurs possibles : france | benelux | europe | world
# Plus la zone est large, plus la requete coute cher en credits :
#   <= 25 deg2 -> 1 credit | <= 100 -> 2 | <= 400 -> 3 | au-dela / monde -> 4
SKYTRACE_REGION=france

# --- Budget de credits -----------------------------------------------------
# Le client refuse d'appeler l'API au-dela de ce budget journalier.
# 400 en anonyme, davantage avec un compte (voir la doc OpenSky).
SKYTRACE_DAILY_CREDIT_BUDGET=400

# --- Stockage --------------------------------------------------------------
# Chemins ABSOLUS de preference (dbt et Dagster ne partagent pas le meme cwd).
# Laisser vide pour utiliser <racine du projet>/data
SKYTRACE_DATA_DIR=
SKYTRACE_DUCKDB_PATH=

# --- Divers ----------------------------------------------------------------
SKYTRACE_LOG_LEVEL=INFO
SKYTRACE_REQUEST_TIMEOUT=30
SKYTRACE_MAX_RETRIES=4
