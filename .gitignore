# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets & config locale
.env

# Donnees (le lac de donnees ne va jamais dans git EN LOCAL)
# On ignore le CONTENU des repertoires, pas les repertoires eux-memes :
# `data/raw/` ignorerait le dossier entier et git ne descendrait meme pas
# dedans, rendant la negation `!.gitkeep` inoperante.
#
# CE QUI EST DEJA VERSIONNE, ET POURQUOI CE N'EST PLUS AUTOMATIQUE. Le depot
# suit 49 Parquet dans `data/raw/`, du 19 au 22 aout 2026. Ils y ont ete
# pousses par le collecteur de l'epoque, qui publiait le lac dans git faute
# de stockage objet. Depuis le passage a R2, plus aucun workflow n'ecrit dans
# git : ces fichiers sont un echantillon FIGE, conserve a dessein pour qu'un
# clone fonctionne sans identifiants R2. Ils ne grossissent plus.
#
# L'ignore ci-dessous empeche donc d'en ajouter de nouveaux par megarde ;
# il ne retire pas ceux qui sont deja suivis.
data/raw/*
data/warehouse/*
# Artefacts de modeles : ils se reconstruisent par `skytrace model train`, et
# un binaire de plusieurs mega-octets par reentrainement ferait enfler le
# depot sans rien apporter. Seule la fiche compte, et elle est reproductible.
data/models/*
data/.credit_ledger.json
!data/raw/.gitkeep
!data/warehouse/.gitkeep

# dbt
dbt/skytrace/target/
dbt/skytrace/dbt_packages/
dbt/skytrace/logs/
# Identifiant anonyme genere par dbt a la premiere execution, propre a la
# machine : il n'a rien a faire dans le depot.
dbt/skytrace/.user.yml

# Dagster
# L'etat d'execution (SQLite, journaux, artefacts) est local a la machine,
# mais la configuration de l'instance est versionnee.
.dagster_home/*
!.dagster_home/dagster.yaml
orchestration/tmp*/
.tmp_dagster_home*/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
node_modules/
.wrangler/
